# /opt/sunnitai-be/.env.worker3 -- read by sunnitai-ingest-3 AFTER /opt/sunnitai-be/.env (same owner and mode 600
# as .env): only what differs for the third worker. The failed folder stays shared; the chunk waits
# (ANALISI_CHUNK_TIMEOUTS) come from .env since 12 Nov 2026.
BATCH_UPLOAD_DIR=/opt/sunnitai-be/document_upload_3
BATCH_LOG_FILE=/var/log/sunnitai-ingest-3.log
