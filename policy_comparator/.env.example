# Policy Comparator — example configuration.
#
# Copy to .env and adjust. NEVER put a real credential in this file: it is
# committed. Provider secrets are referenced by the *name* of the environment
# variable that holds them (see the *_ENV settings below), and the value lives
# only in your real environment or secret manager.
#
# Out of the box, with none of this set, the application runs entirely on
# deterministic demonstration data and contacts nobody.

# ---------------------------------------------------------------- application
# development | test | production
PC_MODE=development

# SQLite for local work; PostgreSQL in production.
#   postgresql+psycopg2://user:password@localhost:5432/policy_comparator
PC_DATABASE_URL=sqlite:///./policy_comparator/var/policy_comparator.db

# Encrypts sensitive stored fields (tax codes, addresses, phone numbers).
# Generate with:  python -m policy_comparator.cli genkey
# REQUIRED when PC_MODE=production — the app refuses to start without it.
# Changing it makes existing encrypted data unreadable.
PC_ENCRYPTION_KEY=

# Signs staff access tokens. Set this to the parent platform's JWT_SECRET_KEY
# if you want tokens issued there to be accepted here too.
PC_JWT_SECRET_KEY=change-me
PC_JWT_EXPIRE_MINUTES=720

PC_LOG_LEVEL=INFO

# ------------------------------------------------------------ live automation
# THE master switch. While false, every provider stays in mock mode no matter
# how it is configured below, and nothing leaves this machine.
#
# A live submission additionally requires ALL of:
#   1. the provider is configured (mode + URL),
#   2. the provider is marked authorized,
#   3. this flag is true,
#   4. a valid consent record exists for the quotation request,
#   5. a staff user explicitly started the request.
LIVE_PROVIDER_AUTOMATION=false

# ----------------------------------------------------------------- the worker
# How many jobs one worker claims at a time.
PC_WORKER_CONCURRENCY=2
# Upper bound on providers contacted simultaneously.
PC_MAX_CONCURRENT_PROVIDERS=4

PC_PROVIDER_TIMEOUT_SECONDS=60
PC_PROVIDER_RETRY_COUNT=2
PC_PROVIDER_RETRY_BACKOFF_SECONDS=2

# Consecutive failures before a provider is skipped, and for how long.
PC_CIRCUIT_BREAKER_THRESHOLD=3
PC_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

# --------------------------------------------------------- limits & retention
PC_QUOTE_RATE_LIMIT_PER_HOUR=60
PC_DATA_RETENTION_DAYS=365

# ---------------------------------------------------------------- diagnostics
# Sanitized failure screenshots from portal automation.
PC_STORE_DIAGNOSTICS=true
PC_DIAGNOSTICS_DIR=./policy_comparator/var/diagnostics
# Full page HTML on failure. OFF by default: a rendered quote page contains the
# customer's personal data. Turn on only for a debugging session.
PC_STORE_RAW_PAGES=false

# ------------------------------------------------------------------ providers
# For each provider:
#   _MODE         mock | api | browser
#                 Priority order is: official/partner API first, an authorized
#                 portal second, browser automation only where no API exists.
#   _AUTHORIZED   the client has an authorized relationship with this provider.
#                 Required for any live submission — never set it speculatively.
#   _API_BASE_URL / _PORTAL_URL
#   _API_KEY_ENV / _USERNAME_ENV / _PASSWORD_ENV
#                 The NAME of the variable holding the secret, not the secret.
#   _TIMEOUT_SECONDS / _RETRY_COUNT   optional per-provider overrides.

# --- Zurich (insurer) — https://www.zurich.it/
PC_PROVIDER_ZURICH_MODE=mock
PC_PROVIDER_ZURICH_AUTHORIZED=false
PC_PROVIDER_ZURICH_API_BASE_URL=
PC_PROVIDER_ZURICH_PORTAL_URL=https://www.zurich.it/
PC_PROVIDER_ZURICH_API_KEY_ENV=ZURICH_API_KEY
PC_PROVIDER_ZURICH_USERNAME_ENV=
PC_PROVIDER_ZURICH_PASSWORD_ENV=

# --- Allianz (insurer) — https://fastquote.allianz.it/
PC_PROVIDER_ALLIANZ_MODE=mock
PC_PROVIDER_ALLIANZ_AUTHORIZED=false
PC_PROVIDER_ALLIANZ_API_BASE_URL=
PC_PROVIDER_ALLIANZ_PORTAL_URL=https://fastquote.allianz.it/
PC_PROVIDER_ALLIANZ_API_KEY_ENV=ALLIANZ_API_KEY

# --- Generali (insurer) — auto product, not the home-insurance page
PC_PROVIDER_GENERALI_MODE=mock
PC_PROVIDER_GENERALI_AUTHORIZED=false
PC_PROVIDER_GENERALI_API_BASE_URL=
PC_PROVIDER_GENERALI_PORTAL_URL=https://www.generali.it/preventivatori/preventivatore-auto-quota-facile
PC_PROVIDER_GENERALI_API_KEY_ENV=GENERALI_API_KEY

# --- CercAssicurazioni (AGGREGATOR, not an insurer)
# Returns quotes issued by other companies, which may duplicate the insurers
# above. Duplicates are detected and linked, never silently dropped.
PC_PROVIDER_CERCASSICURAZIONI_MODE=mock
PC_PROVIDER_CERCASSICURAZIONI_AUTHORIZED=false
PC_PROVIDER_CERCASSICURAZIONI_API_BASE_URL=
PC_PROVIDER_CERCASSICURAZIONI_PORTAL_URL=https://www.cercassicurazioni.it/assicurazione-auto/preventivo1.html
PC_PROVIDER_CERCASSICURAZIONI_API_KEY_ENV=CERCASSICURAZIONI_API_KEY

# ------------------------------------------------------- demo / test controls
# Simulated provider latency, so the progress screen has something to show.
PC_MOCK_LATENCY_MS=400
# Force one provider to fail, to demonstrate the outage and retry paths:
#   quoted | unavailable | timed_out | failed | manual_action_required
#   | authentication_required | configuration_error | missing_information
# PC_MOCK_FORCE_OUTCOME_ZURICH=unavailable

# Contract tests against real provider sites. Disabled unless explicitly on.
PC_RUN_EXTERNAL_CONTRACT_TESTS=false
