# =============================================================================
# LLM Configuration
# =============================================================================
# Option A: OpenAI
#   OPENAI_API_KEY=sk-proj-your-key-here
#   OPENAI_MODEL=gpt-4o
#
# Option B: Self-hosted / OpenAI-compatible (vLLM, Ollama, RunPod)
#   LLM_BASE_URL=https://your-endpoint/v1
#   LLM_API_KEY=your-api-key
#   LLM_MODEL=nemotron-2-30B-A3B
#
# LLM_MODEL must match an id from the provider (wrong name → HTTP 404 from the LLM API).
# Example check: curl -sS "${LLM_BASE_URL%/v1}/v1/models" -H "Authorization: Bearer $LLM_API_KEY"

LLM_BASE_URL=https://your-endpoint/v1
LLM_API_KEY=your-api-key
LLM_MODEL=your-model-name

# =============================================================================
# Embedding Configuration
# =============================================================================
# Option A: Local (no API key needed — runs on server CPU)
#   EMBEDDING_PROVIDER=local
#   EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
#   EMBEDDING_DIMENSIONS=1024
#
# Option B: OpenAI
#   EMBEDDING_PROVIDER=openai
#   OPENAI_API_KEY=sk-proj-your-key-here
#   EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDING_DIMENSIONS=1536

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSIONS=1024

# =============================================================================
# Neo4j
# =============================================================================
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j

# =============================================================================
# PostgreSQL
# =============================================================================
# App and Alembic migrations both read DATABASE_URL when set.
# Leave unset only if you use the built-in local database default.
# DATABASE_URL=postgresql://user:url-encoded-password@localhost/astrea

# =============================================================================
# Cypher query log (optional — defaults under <project>/data/logs/)
# =============================================================================
# If logs land in the wrong folder (e.g. site-packages), set the deploy root:
# CHATBOT_PROJECT_ROOT=/opt/chatbot
# CYPHER_LOG_PATH=/opt/chatbot/data/logs/cypher_queries.log
# CYPHER_LOG_MAX_BYTES=5242880

# =============================================================================
# Optional: Tavily (web search)
# =============================================================================
# TAVILY_API_KEY=tvly-your-key-here

# =============================================================================
# Verbose logging (set to true to enable pipeline timing logs via sunnitai.verbose)
# =============================================================================
VERBOSE_LOGGING=false

# =============================================================================
# Reranker (optional — cross-encoder reranking after BM25+dense retrieval)
# =============================================================================
RERANKER_ENABLED=false
RERANKER_MODEL=reranker
RERANKER_URL=http://217.160.8.129:8002/v1/rerank

# =============================================================================
# Stripe billing
# =============================================================================
# Required by SunnitAI-V2 backend:
# - STRIPE_SECRET_KEY is the backend secret key, never expose it in the frontend.
# - STRIPE_WEBHOOK_SECRET is the signing secret for /api/billing/webhook.
# - Price ids must match the plan ids used by the frontend:
#     plus-single-monthly -> STRIPE_PRICE_PLUS_SINGLE_MONTHLY
#     plus-single-annual  -> STRIPE_PRICE_PLUS_SINGLE_ANNUAL
#     plus-multiuser      -> STRIPE_PRICE_PLUS_MULTIUSER
#
# Local webhook check:
#   stripe listen --forward-to localhost:8000/api/billing/webhook
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_PLUS_SINGLE_MONTHLY=price_test_single_monthly
STRIPE_PRICE_PLUS_SINGLE_ANNUAL=price_test_single_annual
STRIPE_PRICE_PLUS_MULTIUSER=price_test_multiuser
STRIPE_TRIAL_DAYS=7
STRIPE_MULTIUSER_MIN_SEATS=3
# Enable only after Stripe Tax is configured for the account.
STRIPE_AUTOMATIC_TAX_ENABLED=false

# Optional server-side analytics event receiver.
# The Stripe webhook posts `free_trial` and paid `purchase` JSON payloads here.
# Point it to a GTM server-side endpoint or analytics relay when available.
# GTM_EVENT_WEBHOOK_URL=https://analytics.example.com/stripe-events
# GTM_EVENT_WEBHOOK_SECRET=replace-with-shared-secret

# Frontend/public app URL used by deployment docs and external routing.
# The Python backend currently receives success/cancel URLs from the client.
APP_PUBLIC_URL=https://app.astrea.sunnit.ai
